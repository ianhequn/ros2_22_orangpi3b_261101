<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="dd_chassis_01_ros2_control" params="name prefix hwi_mode serial_device">

        <xacro:if value="${hwi_mode=='sim'}">
            <ros2_control name="${name}" type="system">
                <hardware>
                    <plugin>ign_ros2_control/IgnitionSystem</plugin>
                </hardware>

                <joint name="${prefix}wheel_l">
                    <command_interface name="velocity" />
                    <state_interface name="position" />
                    <state_interface name="velocity" />
                </joint>

                <joint name="${prefix}wheel_r">
                    <command_interface name="velocity" />
                    <state_interface name="position" />
                    <state_interface name="velocity" />
                </joint>
            </ros2_control>
        </xacro:if>

        <xacro:if value="${hwi_mode=='real'}">
            <ros2_control name="${name}" type="system">
                <hardware>
                    <!-- 真机硬件接口插件，源码在 orangepi 侧的
                         dd_chassis_001_driver 包。

                         本机开发时（gazebo.launch.py hwi_mode:=real）：
                         该插件通过虚拟串口与串口转发节点通信，转发节点再把
                         数据桥到 Gazebo 话题，以此模拟 MCU 固件行为。
                         真机部署时：串口直连 MCU。
                         两种场景用的是同一份代码和同一套参数，差别仅在
                         serial_device 指向哪里。 -->
                    <plugin>dd_chassis_001_driver/DDChassis001System</plugin>

                    <!-- ===== 串口 ===== -->
                    <param name="serial_device">${serial_device}</param>
                    <param name="baud_rate">1000000</param>

                    <!-- 帧尾魔数(uint32)，64 字节上报帧最后 4 字节。
                         协议无帧头，靠它对齐 -->
                    <param name="frame_end">0x7F800000</param>
                    <param name="frame_timeout_ms">500</param>
                    <param name="timeout_stops_motors">true</param>

                    <!-- ===== 控制 ===== -->
                    <param name="max_wheel_velocity">25.0</param>
                    <param name="command_epsilon">0.01</param>
                    <param name="command_repeat_period_ms">0</param>

                    <!-- ===== 两轮映射与标定 ===== -->
                    <param name="left_wheel_joint">${prefix}wheel_l</param>
                    <param name="right_wheel_joint">${prefix}wheel_r</param>
                    <param name="left_motor_index">1</param>
                    <param name="right_motor_index">0</param>
                    <!-- 关节角速度(rad/s) = 固件 speed 值 * speed_scale。
                         实机标定值 0.030063（≈ (1mm/s)/0.0325m = 0.030769），
                         说明固件 speed 单位基本是 mm/s。仿真必须用同一个系数，
                         否则 gz 里的轮速会被放大 33 倍。 -->
                    <param name="left_speed_scale">0.030063</param>
                    <param name="right_speed_scale">0.030063</param>
                    <param name="left_invert">false</param>
                    <param name="right_invert">false</param>

                    <!-- ===== IMU（驱动自己发 /imu 话题，不走 state interface） ===== -->
                    <param name="publish_imu">true</param>
                    <param name="imu_topic">imu</param>
                    <param name="imu_frame_id">${prefix}imu_link</param>
                    <param name="imu_yaw_field">3</param>
                    <param name="imu_angle_is_deg">true</param>
                    <param name="imu_yaw_sign">1.0</param>
                    <param name="imu_publish_rate">120.0</param>
                    <param name="imu_stamp_offset_calib_s">10.0</param>

                    <!-- 上线前改成 false -->
                    <param name="debug_log">true</param>
                </hardware>

                <joint name="${prefix}wheel_l">
                    <command_interface name="velocity" />
                    <state_interface name="position" />
                    <state_interface name="velocity" />
                </joint>

                <joint name="${prefix}wheel_r">
                    <command_interface name="velocity" />
                    <state_interface name="position" />
                    <state_interface name="velocity" />
                </joint>
            </ros2_control>
        </xacro:if>

    </xacro:macro>
</robot>