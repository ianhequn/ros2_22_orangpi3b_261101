<?xml version="1.0"?>
<!-- ============================================================================
     ign_ros2_control 系统插件（只用于 hwi_mode=sim）

     原先写在 dd_chassis_01_gazebo.xacro 里，但那个文件两种模式都会 include，
     导致 real 模式在 Gazebo 里也起了一个 controller_manager，和本机
     ros2_control_node 里的那个抢同一批 controller。挪到这里由顶层按模式决定。

     ⚠ 必须用绝对路径：launch 通过 ros_gz_sim create 把 URDF 交给 Gazebo，
       $(find ...) 在这一步不会被展开。controllers_yaml 由 launch 算好传入。
     ============================================================================ -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="dd_chassis_01_gazebo_ign_ros2_control" params="controllers_yaml">
    <gazebo>
      <plugin filename="ign_ros2_control-system"
        name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <parameters>${controllers_yaml}</parameters>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
