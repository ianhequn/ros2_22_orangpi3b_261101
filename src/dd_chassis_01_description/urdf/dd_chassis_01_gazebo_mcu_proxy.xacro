<?xml version="1.0"?>
<!-- ============================================================================
     仿真时"顶替 MCU"的 Gazebo 侧执行器 + 反馈源（只用于 hwi_mode=real）

     背景：real 模式下 ros2_control 的硬件插件是 dd_chassis_001_driver，
     它只认串口。为了让它在本机也能跑起来，需要有人扮演 MCU 固件：
       * 收 "sz qeiM <i> T <v>" -> 让 Gazebo 里对应的轮子按该速度转
       * 把轮速/IMU 按 64B 帧回吐给串口
     串口那一半由 dd_chassis_001_driver_gz_serial 负责，
     Gazebo 这一半就是本文件。

     JointController（Fortress 6.18）要点：
       - 只有速度控制，没有 <use_velocity_commands>（那是老版本的，已移除）
       - 订阅话题固定为 /model/<model>/joint/<joint>/cmd_vel（gz.msgs.Double）
         <topic> 不写，用这个 scoped 默认名，ros_gz_bridge 按它映射
       - <initial_velocity>0</initial_velocity>：上车先刹住

     JointStatePublisher 要点：
       - 发 gz.msgs.Model（含 position/velocity），bridge 成 sensor_msgs/JointState
       - 不写 <joint_name> 就会发所有关节（含万向球轮），这里只发两个驱动轮
       - 默认话题 /joint_state（实测），bridge_real.yaml 按此映射
     ============================================================================ -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="dd_chassis_01_gazebo_mcu_proxy" params="prefix">

    <gazebo>
      <plugin filename="ignition-gazebo-joint-controller-system"
        name="gz::sim::systems::JointController">
        <joint_name>${prefix}wheel_l</joint_name>
        <initial_velocity>0</initial_velocity>
      </plugin>

      <plugin filename="ignition-gazebo-joint-controller-system"
        name="gz::sim::systems::JointController">
        <joint_name>${prefix}wheel_r</joint_name>
        <initial_velocity>0</initial_velocity>
      </plugin>

      <plugin filename="ignition-gazebo-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
        <joint_name>${prefix}wheel_l</joint_name>
        <joint_name>${prefix}wheel_r</joint_name>
      </plugin>
    </gazebo>

  </xacro:macro>
</robot>
