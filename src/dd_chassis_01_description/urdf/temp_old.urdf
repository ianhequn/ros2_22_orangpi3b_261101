            </material>
        </visual>
        <collision>
            <!-- 同 wheel_l_link：用 cylinder 代替 mesh，便于稳定地调试摩擦。 -->
            <origin
                xyz="0.0135 0 0"
                rpy="0 1.5708 0" />
            <geometry>
                <!-- URDF 的 cylinder 用属性写法（不是 SDF 的子元素写法，
             写成子元素会被 sdformat 静默丢弃，collision 直接消失） -->
                <cylinder radius="0.0325" length="0.027" />
            </geometry>
        </collision>
    </link>
    <joint
