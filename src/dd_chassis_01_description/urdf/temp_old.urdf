    <gazebo>
        <plugin filename="ign_ros2_control-system"
            name="ign_ros2_control::IgnitionROS2ControlPlugin">
            <!-- ⚠️ 你的 launch 是直接 open(urdf).read() 后交给 ros_gz_sim create，
           所以 $(find ...) 不会被展开（那是 xacro 的语法）。
           这里必须写 install 下的绝对路径，或者把 URDF 改成 xacro。 -->
            <parameters>
                /home/u22/MyWork/robot/ros2/ChassisNav_02_u22_wsl/install/dd_chassis_01_description/share/dd_chassis_01_description/config/controllers.yaml</parameters>
        </plugin>
    </gazebo>

    <gazebo reference="ball_wheel_f_link">
        <mu1>0.001</mu1>
        <mu2>0.001</mu2>
        <kp>10000</kp>
        <kd>150</kd>
    </gazebo>
    <gazebo reference="ball_wheel_b_link">
        <mu1>0.001</mu1>
        <mu2>0.001</mu2>
        <kp>10000</kp>
        <kd>150</kd>
    </gazebo>
    <gazebo reference="wheel_l_link">
        <!-- 必须显式写 kp/kd。不写时 SDF 里是空的 <ode/>，即默认 kp=1e12，
         比球轮的 1e4 硬 1 亿倍。两类轮子刚度差这么多会让求解器在接触
         方向上来回跳变，实测表现为"左转时两轮同向、车身不转"。
         这里与球轮取同一个量级。 -->
        <mu1>1.0</mu1>
        <mu2>0.5</mu2>
        <kp>10000</kp>
        <kd>150</kd>
    </gazebo>
    <gazebo reference="wheel_r_link">
        <!-- 必须显式写 kp/kd。不写时 SDF 里是空的 <ode/>，即默认 kp=1e12，
         比球轮的 1e4 硬 1 亿倍。两类轮子刚度差这么多会让求解器在接触
         方向上来回跳变，实测表现为"左转时两轮同向、车身不转"。
         这里与球轮取同一个量级。 -->
        <mu1>1.0</mu1>
        <mu2>0.5</mu2>
        <kp>10000</kp>
        <kd>150</kd>
    </gazebo>
    <!-- ================= 2D 激光雷达 =================
       要点（Fortress 6.18 + ogre2 实测）：
       1. type 用 gpu_lidar / 块名用 <lidar>：sdformat 明确写 gpu_ray/<ray>
          与 gpu_lidar/<lidar> 等价，但前者将被废弃。
       2. 不需要 <pose>，默认与 ydlidar_link 重合。
       3. 不需要 <vertical>：省略时 gz 使用默认单层（samples=1, min=max=0），
          就是水平扫描。
       4. visibility_mask 把地面 visual 排除出射线求交。
          原因：雷达离地仅 3.69cm，gpu_lidar 靠渲染深度图求交，掠射角下
          约 0.4° 的等效误差会被放大成 d = 0.0369/sin(0.4°) ≈ 5.3m 的
          虚假命中，表现为一圈约 10m×10m、跟随车体移动的“方形假墙”。
          实测把地面 visual 降低 2cm，假墙点数就从 0 跳到 224，可确认来源。
          world 里地面 visual 打了 visibility_flags=2（bit1），这里把 bit1
          清掉（0xFFFFFFFF & ~2 = 4294967293）；其它物体默认 flags 全 1，
          照常可见。物理 collision 不受影响，小车不会掉下去。
       5. ydlidar_link 故意不写 <collision>：避免雷达与车体/地面产生物理接触。
       6. sensor 挂在 lidar_scan_link 上，代表真实 YDLIDAR 的测距基准面。
          ydlidar joint 带 rpy="1.5708 0 0"，ydlidar_link 的 +Y 才朝上，
          所以抬高量写在 lidar_scan_joint 的 y 上（0.018）。
          离地高度 = 0.0665(base_link) - 0.0296(ydlidar joint) + 0.018 = 0.0549m。 -->
    <gazebo reference="lidar_scan_link">
        <sensor name="lidar" type="gpu_lidar">
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <topic>scan</topic>
            <gz_frame_id>lidar_scan_link</gz_frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.10</min>
                    <max>20.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
                <visibility_mask>4294967293</visibility_mask>
            </lidar>
        </sensor>
    </gazebo>
    <!-- IMU：装在车体中心，用 base_link 自身即可 -->
    <gazebo reference="base_link">
        <!-- 车体点不在 Gazebo 侧屏蔽。
         虽然可以用 <visual><visibility_flags> 配合雷达的 visibility_mask
         在仿真里精确去掉车体（求交的是 visual，确实可行），但真机没有
         这套机制，必须在 ROS 侧用 laser_filters 过滤。
         为了仿真和真机走同一条数据链路（同样的过滤节点、同样的参数），
         这里保持车体 visual 默认可见。 -->
        <sensor name="imu_sensor" type="imu">
            <always_on>true</always_on>
            <update_rate>100</update_rate>
            <topic>imu</topic>
            <gz_frame_id>base_link</gz_frame_id>
            <imu>
                <angular_velocity>
                    <x>
                        <noise type="gaussian">
                            <mean>0</mean>
                            <stddev>0.0002</stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0</mean>
                            <stddev>0.0002</stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0</mean>
                            <stddev>0.0002</stddev>
                        </noise>
                    </z>
                </angular_velocity>
                <linear_acceleration>
                    <x>
                        <noise type="gaussian">
                            <mean>0</mean>
                            <stddev>0.0017</stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0</mean>
                            <stddev>0.0017</stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0</mean>
                            <stddev>0.0017</stddev>
                        </noise>
                    </z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>
    <!-- ============ ros2_control：把两个驱动轮交给控制器管理 ============ -->
    <ros2_control name="IgnitionSystem" type="system">
        <hardware>
            <plugin>ign_ros2_control/IgnitionSystem</plugin>
        </hardware>

        <joint name="wheel_l">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="wheel_r">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
    </ros2_control>
</robot>