    <!-- 扫描面 link：真实 YDLIDAR 的测距基准面在雷达基座上方 18mm，
       而不是 ydlidar_link 原点（STL 双锥体的正中心）。
       单独建一个无质量 link，让 sensor 挂在这里，好处是：
       - TF 树里 lidar_scan_link 就代表真实扫描面，slam 建图精度正确
       - 不动 ydlidar_link 的位置，RViz 里的模型不会悬空
       fixed 关节会在 URDF->SDF 时被融合，不引入额外自由度。 -->
    <link name="lidar_scan_link" />

    <joint name="lidar_scan_joint" type="fixed">
        <!-- ydlidar joint 有 rpy="1.5708 0 0"（绕X+90°），所以 ydlidar_link 的
         +Y 才对应 base_link 的 +Z（向上）。要抬高扫描面 18mm 必须写 y。 -->
        <origin xyz="0 0.018 0" rpy="-1.5708 0 0" />
        <parent link="ydlidar_link" />
        <child link="lidar_scan_link" />
    </joint>
    <link
        name="wheel_l_link">
        <inertial>
            <origin
                xyz="0.0146359365211945 -3.46944695195361E-18 -3.46944695195361E-18"
                rpy="0 0 0" />
            <mass
                value="0.0564190770676561" />
            <inertia
                ixx="3.77293491814946E-05"
                ixy="2.5125245074898E-21"
                ixz="-2.88576369248561E-21"
                iyy="2.23688728763878E-05"
                iyz="1.6940658945086E-21"
                izz="2.23688728763877E-05" />
        </inertial>
        <visual>
            <origin
                xyz="0 0 0"
                rpy="0 0 0" />
            <geometry>
                <mesh
                    filename="package://dd_chassis_01_description/meshes/wheel_l_link.STL" />
            </geometry>
            <material
                name="">
                <color
                    rgba="1 1 1 1" />
            </material>
        </visual>
        <collision>
            <!-- 用 cylinder 而不是 mesh。
           Fortress 默认物理引擎是 DART，mesh-mesh 接触的摩擦和滚动
           表现不符合直觉，改 mu 几乎观察不到变化。
           尺寸取自 STL 实测：X 厚 0.027、Y/Z 直径 0.065 → 半径 0.0325。
           mesh 的 X 区间是 [0, 0.027]，中心在 0.0135，所以要偏 0.0135。
           rpy 0 1.5708 0 把 cylinder 默认的 Z 轴转到轮子的 X 轴。 -->
            <origin
                xyz="0.0135 0 0"
                rpy="0 1.5708 0" />
            <geometry>
                <!-- URDF 的 cylinder 用属性写法（不是 SDF 的子元素写法，
             写成子元素会被 sdformat 静默丢弃，collision 直接消失） -->
                <cylinder radius="0.0325" length="0.027" />
            </geometry>
        </collision>
    </link>
    <joint
        name="wheel_l"
        type="continuous">
        <origin
            xyz="0 0.17 -0.034"
            rpy="0 0 1.5708" />
        <parent
            link="base_link" />
        <child
            link="wheel_l_link" />
        <axis
            xyz="1 0 0" />
    </joint>
