<!-- This URDF was automatically created by SolidWorks to URDF Exporter! Originally created by
Stephen Brawner (brawner@gmail.com) 
     Commit Version: 1.6.0-4-g7f85cfe  Build Version: 1.6.7995.38578
     For more information, please see http://wiki.ros.org/sw_urdf_exporter -->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    parent    : 父连杆（parent link）名称
    prefix    : 命名空间前缀
    *origin   : 通过 <xacro:insert_block name="origin" />
                  指定相对父连杆的位置
                  例如传入 <origin xyz="0 0 0" rpy="0 0 0"/>
  -->
  <xacro:macro name="test2_t03_dd_chassis_u_m" params="parent prefix *origin">

    <!-- 父link到小车地面的joint。

         ⚠ parent 为空时不生成这个 joint，让 base_footprint 直接当根。
         这不是可选优化，而是 Gazebo 的硬性要求：
         URDF->SDF 时，fixed joint 的 parent 如果叫 "world"，sdformat 会
         把它当成【世界的全局坐标系】，等于把整台车焊死在世界上。
         后果是模型 <static>0</static> 却永远不动、也不落地（实测：发
         cmd_vel 后轮子 joint_states 在转，但 ign model 查询位姿永远是
         初始值）。
         所以只有真要挂到外部 link（多机器人、moveit）时才传 parent。 -->
    <xacro:if value="${parent != ''}">
      <joint name="${prefix}base_joint" type="fixed">
        <xacro:insert_block name="origin" />
        <parent link="${parent}" />
        <child link="${prefix}base_footprint" />
      </joint>
    </xacro:if>

    <!-- 小车地面link -->
    <link name="${prefix}base_footprint" />
    <!-- base_link原点相对小车地面的位置，处理STL原点不在地面的问题 -->
    <joint name="${prefix}base_footprint_joint" type="fixed">
      <origin xyz="0 0 0.0665" rpy="0 0 0" />
      <parent link="${prefix}base_footprint" />
      <child link="${prefix}base_link" />
    </joint>

    <link
      name="${prefix}base_link">
      <inertial>
        <origin
          xyz="0.00225643442430636 -3.84083228292811E-11 -0.00775518401120619"
          rpy="0 0 0" />
        <mass
          value="0.526954793781656" />
        <inertia
          ixx="0.00500714985145418"
          ixy="-2.6963929724647E-12"
          ixz="6.5119903813237E-05"
          iyy="0.00565174435626673"
          iyz="-8.29351874306313E-13"
          izz="0.0103982208977341" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://dd_chassis_01_description/meshes/base_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="1 1 1 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://dd_chassis_01_description/meshes/base_link.STL" />
        </geometry>
      </collision>
    </link>
    <link
      name="${prefix}ydlidar_link">
      <inertial>
        <origin
          xyz="0.00612113163111172 0.0116760548388481 -1.169115360589E-15"
          rpy="0 0 0" />
        <mass
          value="0.0936792550428074" />
        <inertia
          ixx="2.72585018191627E-05"
          ixy="7.13811165160373E-06"
          ixz="-1.52764527744402E-18"
          iyy="5.89984255634353E-05"
          iyz="4.45008735705321E-19"
          izz="4.76173774105997E-05" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://dd_chassis_01_description/meshes/ydlidar_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="1 1 1 1" />
        </material>
      </visual>
    </link>
    <joint
      name="${prefix}ydlidar"
      type="fixed">
      <origin
        xyz="0.158 0 -0.0296"
        rpy="1.5708 0 0" />
      <parent
        link="${prefix}base_link" />
      <child
        link="${prefix}ydlidar_link" />
      <axis
        xyz="0 0 0" />
    </joint>

    <!-- 扫描面 link / imu_link 已移到 dd_chassis_01_sensors.xacro -->
    <link
      name="${prefix}wheel_l_link">
      <inertial>
        <origin
          xyz="0.0146359365211945 -3.46944695195361E-18 -3.46944695195361E-18"
          rpy="0 0 0" />
        <mass
          value="0.0564190770676561" />
        <inertia
          ixx="3.77293491814946E-05"
          ixy="2.5125245074898E-21"
          ixz="-2.88576369248561E-21"
          iyy="2.23688728763878E-05"
          iyz="1.6940658945086E-21"
          izz="2.23688728763877E-05" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://dd_chassis_01_description/meshes/wheel_l_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="1 1 1 1" />
        </material>
      </visual>
      <collision>
        <!-- 用 cylinder 而不是 mesh。
           Fortress 默认物理引擎是 DART，mesh-mesh 接触的摩擦和滚动
           表现不符合直觉，改 mu 几乎观察不到变化。
           尺寸取自 STL 实测：X 厚 0.027、Y/Z 直径 0.065 → 半径 0.0325。
           mesh 的 X 区间是 [0, 0.027]，中心在 0.0135，所以要偏 0.0135。
           rpy 0 1.5708 0 把 cylinder 默认的 Z 轴转到轮子的 X 轴。 -->
        <origin
          xyz="0.0135 0 0"
          rpy="0 1.5708 0" />
        <geometry>
          <!-- URDF 的 cylinder 用属性写法（不是 SDF 的子元素写法，
             写成子元素会被 sdformat 静默丢弃，collision 直接消失） -->
          <cylinder radius="0.0325" length="0.027" />
        </geometry>
      </collision>
    </link>
    <joint
      name="${prefix}wheel_l"
      type="continuous">
      <origin
        xyz="0 0.17 -0.034"
        rpy="0 0 1.5708" />
      <parent
        link="${prefix}base_link" />
      <child
        link="${prefix}wheel_l_link" />
      <axis
        xyz="1 0 0" />
    </joint>
    <link
      name="${prefix}wheel_r_link">
      <inertial>
        <origin
          xyz="0.0146359365211944 0 -3.46944695195361E-18"
          rpy="0 0 0" />
        <mass
          value="0.0564190770676561" />
        <inertia
          ixx="3.77293491814946E-05"
          ixy="-1.4276421590599E-21"
          ixz="-6.94944358670354E-22"
          iyy="2.23688728763877E-05"
          iyz="1.6940658945086E-21"
          izz="2.23688728763877E-05" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://dd_chassis_01_description/meshes/wheel_r_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="1 1 1 1" />
        </material>
      </visual>
      <collision>
        <!-- 同 wheel_l_link：用 cylinder 代替 mesh，便于稳定地调试摩擦。 -->
        <origin
          xyz="0.0135 0 0"
          rpy="0 1.5708 0" />
        <geometry>
          <!-- URDF 的 cylinder 用属性写法（不是 SDF 的子元素写法，
             写成子元素会被 sdformat 静默丢弃，collision 直接消失） -->
          <cylinder radius="0.0325" length="0.027" />
        </geometry>
      </collision>
    </link>
    <joint
      name="${prefix}wheel_r"
      type="continuous">
      <origin
        xyz="0 -0.17 -0.034"
        rpy="0 0 -1.5708" />
      <parent
        link="${prefix}base_link" />
      <child
        link="${prefix}wheel_r_link" />
      <axis
        xyz="-1 0 0" />
    </joint>
    <link
      name="${prefix}ball_wheel_f_link">
      <inertial>
        <origin
          xyz="0 -6.93889390390723E-18 -1.50510220113668E-18"
          rpy="0 0 0" />
        <mass
          value="0.00418879020478639" />
        <inertia
          ixx="1.67551608191456E-07"
          ixy="0"
          ixz="0"
          iyy="1.67551608191456E-07"
          iyz="0"
          izz="1.67551608191456E-07" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://dd_chassis_01_description/meshes/ball_wheel_f_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="1 1 1 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <sphere radius="0.01" />
        </geometry>
      </collision>
    </link>
    <joint
      name="${prefix}ball_wheel_f"
      type="fixed">
      <origin
        xyz="0.184 0 -0.0565"
        rpy="1.5708 0 0" />
      <parent
        link="${prefix}base_link" />
      <child
        link="${prefix}ball_wheel_f_link" />
      <axis
        xyz="0 0 0" />
    </joint>
    <link
      name="${prefix}ball_wheel_b_link">
      <inertial>
        <origin
          xyz="0 -6.93889390390723E-18 2.29621274840129E-19"
          rpy="0 0 0" />
        <mass
          value="0.00418879020478639" />
        <inertia
          ixx="1.67551608191456E-07"
          ixy="0"
          ixz="0"
          iyy="1.67551608191456E-07"
          iyz="0"
          izz="1.67551608191456E-07" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://dd_chassis_01_description/meshes/ball_wheel_b_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="1 1 1 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <sphere radius="0.01" />
        </geometry>
      </collision>
    </link>
    <joint
      name="${prefix}ball_wheel_b"
      type="fixed">
      <origin
        xyz="-0.18 0 -0.0565"
        rpy="1.5708 0 0" />
      <parent
        link="${prefix}base_link" />
      <child
        link="${prefix}ball_wheel_b_link" />
      <axis
        xyz="0 0 0" />
    </joint>

  </xacro:macro>
</robot>